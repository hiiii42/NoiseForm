{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["public/js/**/*.js"],
  "exclude": ["node_modules", "docs", "test"]
}
